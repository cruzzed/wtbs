#!/usr/bin/env bash
# mysql strap — create lifecycle: clone the main repo's database into
# WTBS_DB_NAME and point the worktree's .env at it.
#
# Credentials come from the hook environment, which exports the main repo's
# .env — so DB_DATABASE there is the clone SOURCE. Requires: mysql,
# mysqldump.
#
# Compose with auto-ports for FORWARD_DB_PORT if the project wants it:
#   straps: ["auto-ports(db:33060)"]  +  env: FORWARD_DB_PORT: "{auto_ports.db}"
set -euo pipefail

: "${WTBS_DB_NAME:?WTBS_DB_NAME is not set — lifecycle scripts run inside wtbs}"

"$(dirname "${BASH_SOURCE[0]}")/db-clone" "$WTBS_DB_NAME"

if [[ -f ./.env ]]; then
    if grep -q '^DB_DATABASE=' ./.env; then
        sed -i -E "s|^DB_DATABASE=.*|DB_DATABASE=${WTBS_DB_NAME}|" ./.env
    else
        echo "DB_DATABASE=${WTBS_DB_NAME}" >> ./.env
    fi
fi
