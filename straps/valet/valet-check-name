#!/usr/bin/env bash
# Warn when the valet server name derived from a worktree directory would
# approach nginx's default server_names_hash_bucket_size (64): valet writes
# <site>.<tld> plus www. and *. variants, and an over-long server name makes
# the nginx config test fail — nginx then refuses to start for EVERY valet
# site on the machine, with no hint that a directory name caused it.
set -euo pipefail

site="${1:?usage: valet-check-name <site>}"

tld="test"
config="${VALET_CONFIG:-$HOME/.config/valet/config.json}"
if [[ -f "$config" ]]; then
    detected="$(grep -oE '"tld"[[:space:]]*:[[:space:]]*"[^"]+"' "$config" | head -n1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
    [[ -n "${detected:-}" ]] && tld="$detected"
fi

fqdn="$site.$tld"
longest=$(( 4 + ${#fqdn} ))  # "www." prefix variant
if [[ $longest -gt 64 ]]; then
    echo "WARN: valet server name 'www.$fqdn' ($longest chars) EXCEEDS nginx's default server_names_hash_bucket_size (64)" >&2
    echo "WARN: securing this site will make nginx fail to start for ALL valet sites on this machine" >&2
    echo "WARN: destroy this worktree and re-create with --dir <shorter-name>, or raise server_names_hash_bucket_size in nginx.conf" >&2
elif [[ $longest -gt 56 ]]; then
    echo "WARN: valet server name 'www.$fqdn' ($longest chars) is close to nginx's default server_names_hash_bucket_size (64)" >&2
    echo "WARN: consider re-creating this worktree with --dir <shorter-name>" >&2
fi
exit 0
